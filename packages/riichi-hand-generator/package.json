{
  "name": "riichi-hand-generator",
  "version": "0.0.1",
  "description": "Generate randomized valid Riichi Mahjong winning hands satisfying scoring constraints",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example:30-fu": "npm run build && node examples/generate-30-fu.mjs",
    "example:batch": "npm run build -w riichi-score && npm run build && node examples/generate-batch.mjs"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "riichi-score": "^2.0.0"
  },
  "keywords": [
    "riichi",
    "mahjong",
    "japanese-mahjong",
    "generator",
    "scoring",
    "hand-generator"
  ],
  "author": "Cameron Webley <cameron.webley@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cwebley/kotenho.git",
    "directory": "packages/riichi-hand-generator"
  },
  "bugs": {
    "url": "https://github.com/cwebley/kotenho/issues"
  },
  "homepage": "https://github.com/cwebley/kotenho#readme",
  "engines": {
    "node": ">=20"
  }
}
