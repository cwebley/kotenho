{
  "name": "riichi-score",
  "version": "3.0.0",
  "description": "Score riichi mahjong hands with yaku, fu, dora, payments, and configurable rulesets.",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build:cjs": "tsc --project tsconfig.cjs.json && node scripts/write-cjs-package.cjs",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build": "npm run build:cjs && npm run build:esm",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cwebley/kotenho.git",
    "directory": "packages/riichi-score"
  },
  "bugs": {
    "url": "https://github.com/cwebley/kotenho/issues"
  },
  "homepage": "https://github.com/cwebley/kotenho#readme",
  "author": "Cameron Webley <cameron.webley@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "riichi",
    "mahjong",
    "japanese-mahjong",
    "scoring",
    "score-calculator"
  ],
  "devDependencies": {
    "prettier": "^3.5.1",
    "typescript": "^5.0.0",
    "vitest": "^3.0.4"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
